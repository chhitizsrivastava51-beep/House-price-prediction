# ==========================================
# Gnani.ai Voice AI Configuration
# ==========================================
# Obtain your API Key / Access Token from your Gnani.ai developer console
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_token_here

# Gnani.ai TTS Endpoint (Default: https://tts.gnani.ai/api/v1/tts)
GNANI_TTS_ENDPOINT=https://tts.gnani.ai/api/v1/tts

# Default TTS Voice Language (e.g. hi-IN, en-IN, ta-IN, te-IN)
DEFAULT_TTS_LANG=hi-IN
